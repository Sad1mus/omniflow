{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "index.html",
    "index.css",
    "globals.css",
    "main.tsx",
    "vite-env.d.ts",
    "app/**/*",
    "components/**/*",
    "lib/**/*",
    "context/**/*",
    "pages/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}