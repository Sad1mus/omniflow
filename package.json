{
  "name": "agente-clinicas",
  "version": "0.1.0",
  "description": "Agente multi-tenant de WhatsApp para clínicas (vet/dental/estética). Baileys + Claude tool-use + Supabase.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,worker -c blue,green \"npm run dev:server\" \"npm run dev:worker\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "db:migrate": "bash scripts/db-migrate.sh",
    "seed:clinic": "bash scripts/seed-vertical-clinic.sh",
    "seed:real-estate": "bash scripts/seed-vertical-real-estate.sh",
    "bootstrap": "bash scripts/bootstrap-hybrid.sh",
    "bootstrap:phase2": "bash scripts/bootstrap-phase2.sh",
    "lab:test": "tsx src/core/lab/runner.ts"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-prometheus": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@supabase/supabase-js": "^2.49.4",
    "@whiskeysockets/baileys": "^6.7.18",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.14.0",
    "cors": "^2.8.6",
    "date-fns-tz": "^2.0.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.0.0",
    "openai": "^4.77.0",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "pino-http": "^9.0.0",
    "prom-client": "^15.1.2",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.5.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.3.2",
    "puppeteer": "^22.15.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.0.5"
  }
}
